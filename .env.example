# ─── Base de données (Supabase > Project Settings > Database > Connection string) ───
# URL "pooler" (port 6543, ?pgbouncer=true) pour l'application
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=maillots"
# URL directe (port 5432) pour les migrations
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?schema=maillots"

# ─── Sécurité : chaîne aléatoire de 32+ caractères (openssl rand -base64 48) ───
AUTH_SECRET=""

# ─── Adresse publique du site (sans / final) ───
NEXT_PUBLIC_SITE_URL="https://www.votre-boutique.fr"

# ─── Stripe (dashboard.stripe.com > Développeurs > Clés API) ───
STRIPE_SECRET_KEY="sk_test_..."
# Développeurs > Webhooks > endpoint https://votre-site/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Stockage des photos (Supabase > Storage, bucket public "products") ───
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="maillots-products"

# ─── E-mails transactionnels (resend.com) ───
RESEND_API_KEY=""
EMAIL_FROM="Ma Boutique <commandes@votre-domaine.fr>"

# ─── Tâches planifiées (paniers abandonnés, commandes expirées) ───
CRON_SECRET=""
