generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum KitType {
  HOME
  AWAY
  THIRD
  FOURTH
  GOALKEEPER
  SPECIAL
}

enum CategoryType {
  LEAGUE
  NATIONAL
  RETRO
  COMPETITION
  SPECIAL
}

enum ImageKind {
  FRONT
  BACK
  EXTRA
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PromoType {
  PERCENT
  FIXED
}

enum ShippingType {
  HOME
  RELAY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role                 @default(CUSTOMER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  addresses    Address[]
  orders       Order[]
  favorites    Favorite[]
  reviews      Review[]
  returns      ReturnRequest[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  firstName  String
  lastName   String
  line1      String
  line2      String?
  postalCode String
  city       String
  country    String  @default("FR")
  phone      String?
  isDefault  Boolean @default(false)
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  type        CategoryType @default(LEAGUE)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  showOnHome  Boolean      @default(true)
  products    Product[]
  createdAt   DateTime     @default(now())
}

model Product {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  name                 String
  club                 String
  season               String
  kitType              KitType        @default(HOME)
  description          String         @default("")
  /// Prix en centimes
  price                Int
  /// Prix barré (centimes) : si renseigné et > price, le produit est en promotion
  compareAtPrice       Int?
  isActive             Boolean        @default(true)
  isFeatured           Boolean        @default(false)
  isNew                Boolean        @default(false)
  isDemo               Boolean        @default(false)
  deliveryInfo         String?
  customizationEnabled Boolean        @default(true)
  /// Supplément flocage en centimes
  customizationPrice   Int            @default(1500)
  maxNameLength        Int            @default(12)
  flockingColor        String         @default("#FFFFFF")
  /// Position verticale du nom sur la photo de dos, en % de la hauteur
  flockingTop          Int            @default(22)
  categories           Category[]
  images               ProductImage[]
  variants             Variant[]
  players              Player[]
  orderItems           OrderItem[]
  favorites            Favorite[]
  reviews              Review[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([club])
  @@index([isActive, createdAt])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  kind      ImageKind @default(EXTRA)
  sortOrder Int       @default(0)
}

model Variant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size              String
  sortOrder         Int         @default(0)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(2)
  sku               String?
  orderItems        OrderItem[]

  @@unique([productId, size])
}

model Player {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  number    Int
}

model Order {
  id                    String          @id @default(cuid())
  number                String          @unique
  userId                String?
  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String
  status                OrderStatus     @default(PENDING)
  firstName             String
  lastName              String
  phone                 String?
  line1                 String
  line2                 String?
  postalCode            String
  city                  String
  country               String          @default("FR")
  relayPoint            String?
  shippingMethodId      String?
  shippingMethodName    String
  shippingCost          Int
  subtotal              Int
  discountTotal         Int             @default(0)
  discountLabel         String?
  total                 Int
  promoCodeId           String?
  promoCode             PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  stripeSessionId       String?         @unique
  /// Jeton unique par tentative de paiement : empêche la création de commandes en double
  checkoutToken         String?         @unique
  stripePaymentIntentId String?
  marketingConsent      Boolean         @default(false)
  reminderSentAt        DateTime?
  carrier               String?
  trackingNumber        String?
  trackingUrl           String?
  paidAt                DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  refundedAmount        Int             @default(0)
  stockReleased         Boolean         @default(false)
  expiresAt             DateTime?
  adminNote             String?
  items                 OrderItem[]
  events                OrderEvent[]
  returns               ReturnRequest[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId           String?
  variant             Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName         String
  size                String
  imageUrl            String?
  /// Prix unitaire du maillot seul (centimes)
  unitPrice           Int
  customizationName   String?
  customizationNumber Int?
  customizationPrice  Int      @default(0)
  quantity            Int
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())
}

/// Évènements Stripe déjà traités (protection contre les doublons de webhook)
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  type        PromoType @default(PERCENT)
  /// Pourcentage (ex. 10) ou montant en centimes
  value       Int
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  orders      Order[]
  createdAt   DateTime  @default(now())
}

/// Remise automatique "plusieurs maillots" : à partir de minQuantity articles, percentOff % de réduction
model AutoDiscount {
  id          String   @id @default(cuid())
  name        String
  minQuantity Int
  percentOff  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ShippingMethod {
  id           String       @id @default(cuid())
  name         String
  description  String?
  type         ShippingType @default(HOME)
  price        Int
  freeOver     Int?
  deliveryTime String?
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
}

model ShopSettings {
  id                 Int      @id @default(1)
  shopName           String   @default("MAILLOT")
  tagline            String   @default("Le maillot de tes légendes.")
  heroTitle          String   @default("Porte tes couleurs.")
  heroSubtitle       String   @default("Maillots de clubs, sélections et pièces rétro. Floqués à ton nom, expédiés chez toi.")
  heroImageUrl       String?
  announcement       String?
  aboutTitle         String   @default("Notre boutique")
  aboutText          String   @default("Présentez ici votre boutique, votre histoire et votre engagement. Ce texte est modifiable dans Administration > Paramètres.")
  contactEmail       String?
  contactPhone       String?
  contactAddress     String?
  instagramUrl       String?
  tiktokUrl          String?
  stockAlertEmail    String?
  updatedAt          DateTime @updatedAt
}

model Page {
  slug      String   @id
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([userId, productId])
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  consentAt        DateTime  @default(now())
  source           String?
  unsubscribeToken String    @unique @default(cuid())
  unsubscribedAt   DateTime?
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  message   String?
  status    ReturnStatus @default(REQUESTED)
  adminNote String?
  createdAt DateTime     @default(now())
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  orderNumber String?
  subject     String
  message     String
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
